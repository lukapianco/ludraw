{
  "name": "ludraw",
  "private": true,
  "version": "0.9.0",
  "description": "LuDraw — quadro branco infinito open-source, local-first (web, homelab e desktop).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukapianco/ludraw.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.node.json",
    "typecheck:server": "npm --prefix server run typecheck",
    "build:strict": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "audit:legal": "node scripts/audit-clean-room.mjs",
    "docs:legal": "node scripts/audit-clean-room.mjs --write",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:desktop": "node scripts/desktop-notices.mjs",
    "audit:features": "node scripts/audit-features.mjs",
    "docs:features": "node scripts/audit-features.mjs --write",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:version": "node scripts/audit-version.mjs",
    "audit:name": "node scripts/audit-name.mjs",
    "docs:languages": "node scripts/audit-i18n.mjs --write",
    "test:permissions": "node --experimental-strip-types scripts/test-permissions.mjs",
    "test:extensions": "node --experimental-strip-types --no-warnings scripts/test-extensions.mjs",
    "test:design": "node --experimental-strip-types --no-warnings scripts/test-design.mjs",
    "test:extensions:browser": "node scripts/test-extensions-browser.mjs",
    "server:dev": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:server:pg": "npm --prefix server run test:pg",
    "test:server:browser": "node scripts/test-server-browser.mjs",
    "test:collab:browser": "node scripts/test-collab-browser.mjs",
    "test:a11y:browser": "node scripts/test-a11y-browser.mjs",
    "test:docker": "npm --prefix server run test:docker",
    "test:server:multi": "npm --prefix server run test:multi",
    "docker:secrets": "node scripts/docker-secrets.mjs",
    "docker:backup": "node scripts/docker-backup.mjs backup",
    "docker:restore": "node scripts/docker-backup.mjs restore",
    "desktop:web": "vite build && node scripts/desktop-headers.mjs",
    "desktop:build": "npm run desktop:web && cd src-tauri && cargo build --release --locked",
    "desktop:dev": "npm run desktop:web && cd src-tauri && cargo run --locked",
    "desktop:package": "npm run desktop:web && tauri build --ci -- --locked",
    "desktop:icons": "node scripts/render-desktop-icons.mjs",
    "crates": "node scripts/crates.mjs",
    "test:desktop": "node --experimental-strip-types --no-warnings scripts/test-desktop.mjs",
    "test:desktop:rust": "cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked",
    "test:desktop:app": "node scripts/test-desktop-app.mjs",
    "test:desktop:package": "node scripts/test-desktop-package.mjs",
    "mail:assets": "node --experimental-strip-types --no-warnings scripts/render-mail-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@fontsource/gravitas-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nixie-one": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hocuspocus/provider": "4.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "6.4.6"
  }
}
