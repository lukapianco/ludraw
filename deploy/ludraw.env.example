# LuDraw — configurações do serviço "app" no docker-compose.yml (Chat 09 · R3).
# Copie para deploy/ludraw.env (fica fora do git) e descomente o que precisar. Linha vazia = padrão.
# SEM SEGREDOS AQUI: senha de SMTP, segredo do SSO, senha do admin inicial vão por arquivo (*_FILE + Docker secret;
# veja "Segredos extras" em docs/DOCKER.md). A lista completa de variáveis está em server/.env.example.

# --- Endereço -------------------------------------------------------------------------------------------------
# Endereço que as pessoas abrem no navegador (com o proxy reverso, o https:// dele). Usado nos links dos e-mails,
# no SSO e na origem do tempo real.
# LUDRAW_PUBLIC_URL=https://draw.example.com
# Atrás de proxy reverso (Caddy, Traefik, nginx…): quantos saltos confiar (1 = o proxy na frente) ou os IPs dele.
# LUDRAW_TRUST_PROXY=1

# --- Organização ----------------------------------------------------------------------------------------------
# single_org (padrão: uma organização, entrada só por convite) ou multi_org (cada pessoa cria a sua).
# LUDRAW_MODE=single_org
# Pular o assistente do primeiro acesso: nome da organização + admin inicial (a senha por arquivo:
# LUDRAW_ADMIN_PASSWORD_FILE=/run/secrets/admin_password — veja docs/DOCKER.md).
# LUDRAW_ORG_NAME=Minha Empresa
# LUDRAW_ADMIN_EMAIL=admin@example.com
# LUDRAW_ALLOWED_DOMAINS=example.com

# --- E-mail (opcional; no single_org também dá para configurar em Administração → Políticas e domínios → Envio de e-mail;
#     no multi_org só por estas variáveis) ---------------------------------------------------------------------
# LUDRAW_SMTP_HOST=smtp.example.com
# LUDRAW_SMTP_PORT=587
# LUDRAW_SMTP_USER=no-reply@example.com
# LUDRAW_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# LUDRAW_SMTP_FROM=LuDraw <no-reply@example.com>

# --- SSO (OIDC genérico: Keycloak, Authentik, Entra ID, Google…) --------------------------------------------
# OIDC_ISSUER=https://sso.example.com/realms/empresa
# OIDC_CLIENT_ID=ludraw
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_PROVIDER_NAME=SSO da Empresa

# --- Navegador ----------------------------------------------------------------------------------------------
# Sites que podem incorporar boards ("Incorporar board"). Padrão: só a própria origem.
# LUDRAW_FRAME_ANCESTORS=https://wiki.example.com
# Hosts extras para extensões com a permissão "rede" que você aprovou. Padrão: nenhum.
# LUDRAW_CSP_CONNECT_SRC=https://api.example.com

# --- Várias instâncias (opcional) ---------------------------------------------------------------------------
# Com o perfil "redis" (docker compose --profile redis up -d): limites e avisos compartilhados entre instâncias.
# LUDRAW_REDIS_URL_FILE=/run/secrets/redis_url

# --- Outros -------------------------------------------------------------------------------------------------
# LOG_LEVEL=info
# Tela "Sistema visual" (#/design-system, guia de quem contribui). A imagem desliga; true para mostrar.
# LUDRAW_ENABLE_DESIGN_SYSTEM=false
