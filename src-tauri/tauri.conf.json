{
  "productName": "LuDraw",
  "mainBinaryName": "ludraw",
  "version": "../package.json",
  "identifier": "app.ludraw",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "chooser"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "publisher": "LuDraw",
    "homepage": "https://github.com/lukapianco/ludraw",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Quadro branco infinito open-source, local-first.",
    "longDescription": "LuDraw é um quadro branco infinito open-source e local-first. Funciona neste computador (Modo Local) ou conectado ao servidor da sua organização.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
